# 服务端读取，不会暴露到前端构建产物
LLM_API_KEY=

# 服务商显示名称（用于前端提示文案）
LLM_PROVIDER_NAME=Kimi

# 服务地址（Moonshot / Kimi 官方地址）
LLM_BASE_URL=https://api.moonshot.cn/v1

# 模型：kimi-k3.1-pro-highspeed / kimi-k3.1-pro / kimi-k3
LLM_MODEL=kimi-k3.1-pro-highspeed

# 可选：输出 token 上限（2000-8000）。推理模型会额外消耗思考 tokens，建议留足
LLM_MAX_TOKENS=8000

# 可选：采样温度。推理模型仅接受默认值 1，留空则不传该参数
# LLM_TEMPERATURE=1
